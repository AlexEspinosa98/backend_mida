# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=changeme-generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,mida.midominio.local

# Base de datos (formato django-environ db-url)
DATABASE_URL=psql://mida:changeme@db:5432/mida

# Postgres (usado por el servicio db en docker-compose)
POSTGRES_DB=mida
POSTGRES_USER=mida
POSTGRES_PASSWORD=changeme

# LLM local (Qwen2.5-3B-Instruct GGUF, horneado en la imagen — no requiere API key).
# docker-compose.yml fija LLM_MODEL_PATH=/app/models/model.gguf explícitamente
# (la ruta fija que usa el Dockerfile), así que esta variable aquí solo aplica
# si corres Django directamente en el host (fuera de Docker) durante desarrollo.
LLM_MODEL_PATH=/app/models/model.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.2
LLM_N_THREADS=0
